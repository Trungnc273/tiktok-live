# Copy thành .env — KHÔNG commit .env thật (đã có trong .gitignore).

# TikTok LIVE (unofficial, xem docs/research/TIKTOK-LIVE-CAPABILITY.md)
# Multi-tenant: KHÔNG còn dùng biến này để kết nối — mỗi user tự nhập TikTok
# username của họ trong dashboard (PUT /api/auth/tiktok-username). Đặt
# EULER_STREAM_API_KEY dùng chung cho mọi kết nối thật (nếu có).
EULER_STREAM_API_KEY=
# MOCK_TIKTOK=1: mọi phiên theo dõi dùng MockProvider (bơm event giả lập) thay vì
# kết nối TikTok thật — tiện dev/test nhiều "streamer" không cần tài khoản thật.
MOCK_TIKTOK=

# Auth (đăng ký/đăng nhập multi-tenant)
# BẮT BUỘC đặt cố định cho môi trường thật — nếu để trống, server tự sinh secret
# ngẫu nhiên mỗi lần khởi động và MỌI người dùng bị đăng xuất khi restart.
JWT_SECRET=

# Postgres (xem docker-compose.yml) — POSTGRES_PASSWORD override giá trị dev mặc
# định trong docker-compose.yml (PHASE 14 audit M3). Đặt mật khẩu riêng khi deploy.
POSTGRES_PASSWORD=tiktok_live_dev_only
DATABASE_URL=postgres://tiktok_live:tiktok_live_dev_only@127.0.0.1:5544/tiktok_live

# HTTP server (apps/server)
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# CORS cho REST API — mặc định "*" cho dev, PHẢI đặt domain thật khi deploy production
# (PHASE 14 audit L2), ví dụ: https://dashboard.example.com
CORS_ORIGIN=*
# NODE_ENV=production bật cookie "secure" (chỉ gửi qua HTTPS) — để trống cho dev local.
NODE_ENV=

# Thư mục audio (M06 TTS output / M07 sound cấu hình sẵn)
MEDIA_DIR=.media
SOUNDS_DIR=sounds

# OBS WebSocket (M11) — bỏ trống nếu không dùng OBS integration.
OBS_WEBSOCKET_URL=
OBS_WEBSOCKET_PASSWORD=

LOG_LEVEL=info
